		annotation PBI_FormatHint = {"isDecimal":true}

	measure YTD_Number = ```
			
			 var numytd = CALCULATE([Eletricity Usage],DATESYTD('Calendar'[Date]))
			 var res = IF(NOT(ISBLANK([Eletricity Usage])),numytd)
			 RETURN
			    res
			    
			```
