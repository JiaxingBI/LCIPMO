table Measure
	lineageTag: b1ce69b8-843e-4628-914c-09c42e8ef4d2

	measure Identified_2025 =
			
			CALCULATE (
			    SUM ( Productivty[Actual] ),
			    Productivty[Site] = "JIA",
			    Productivty[Year] = "2025",
			    Productivty[Deparment] IN { "Moulding", "Processing", "Packing" }
			)
		formatString: 0.0
		lineageTag: de4bb152-8481-46a7-ae26-b1199cd0ebb0

