table Measure
	lineageTag: b1ce69b8-843e-4628-914c-09c42e8ef4d2

	measure Identified_2025 =
			
			CALCULATE (
			    SUM ( Productivity[Actual] ),
			    Productivity[Site] = "JIA",
			    Productivity[Year] = "2025",
			    Productivity[Department] IN { "Moulding", "Processing", "Packing" }
			)
		formatString: 0.00
		lineageTag: de4bb152-8481-46a7-ae26-b1199cd0ebb0

