	measure IdentifyVTarget = ```
			
			VAR a = FORMAT(SUM('2026Identify'[Identify]), "#.0") & " / "
			VAR b = SUM('2026Identify'[Target])
			VAR c = FORMAT(b, "#.0")
			RETURN
			    a & c
			
			```
		lineageTag: e3c78147-ccff-49c5-89cf-7fa9f5c7f968

	measure JIA_Actual_No_LFAC = ```
			
			 VAR lfac = CALCULATE( SUM('Productivity'[Actual])     ,'Productivity'[Department]="LFAC")
			var x = [JIA_Actual]-lfac
			
			RETURN
			    x
			```
		lineageTag: a0464995-e2b8-40f5-a0f1-8e45823abd62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

