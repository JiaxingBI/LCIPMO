	measure Title_Identified = ```
			
			VAR CurrentMonth =  MAXX(ALLSELECTED('Productivity_InYear') ,Productivity_InYear[Index])
			var condition_ = 
			IF(
			    [Productivity_InYear]>0
			     && 
			     SELECTEDVALUE('Productivity_InYear'[Index]) = CurrentMonth ,
			     "Identified"
			)
			
			RETURN
			    condition_
			```
		lineageTag: bfd10c72-080e-47b8-a4ca-653afa238c74

		changedProperty = Name

	measure Title_Actual = ```
			
			VAR CurrentMonth =  MAXX(ALLSELECTED('Productivity_InYear') ,Productivity_InYear[Index])
			var condition_ = 
			IF(
			    [Productivity_InYear]>0
			     && 
			     SELECTEDVALUE('Productivity_InYear'[Index]) = CurrentMonth ,
			     "YTD Actual"
			)
			
			RETURN
			    condition_
			```
		lineageTag: 48f0460b-16cd-4074-9e4e-b3b9677a6686

		changedProperty = Name

	measure GapforSupporting = [Productivity_InYear]-MAX('Productivity_InYear'[JIATarget])
		formatString: 0.0
		lineageTag: e3fd0bd6-edb7-4739-b8e6-ce59980c39eb

		changedProperty = Name

		changedProperty = FormatString

	measure Productivity_InYear_Nopfp =
			
			var YTDActual = CALCULATE([TotalProductivityValue],'Productivity_InYear'[Value Type]="Actual",'Productivity_InYear'[Month]<= MAX('Productivity_InYear'[Index]))
			var FutureTarget = CALCULATE([TotalProductivityValue],'Productivity_InYear'[Value Type]="Target",'Productivity_InYear'[Month]>MAX('Productivity_InYear'[Index]))
			var pfp = [TotalPfP]
			var res = YTDActual+FutureTarget
			RETURN
			res
		formatString: 0.0
		lineageTag: c72a995e-d932-4e95-86be-a2427ea5d588

		changedProperty = Name

		changedProperty = FormatString

	measure GapByArea_Prod = IF([Pro_JIATarget]>0,[Productivity_InYear_Nopfp]-[Pro_JIATarget])
		formatString: 0.0
		lineageTag: 4f9d926c-81d9-4cd9-bdc9-d639f0c79b40

		changedProperty = Name

		changedProperty = FormatString

	measure Pro_JIATarget = IF(NOT(ISINSCOPE('Productivity_InYear'[Dept.])),MAX('Productivity_InYear'[JIATarget]))
		lineageTag: 43c04cff-9024-493f-a327-aa1a1c02bca9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure x = ```
			
			var t= 
			UNION(
			ROW("Area","PFP","#P", [TotalPfP]),
			ADDCOLUMNS(VALUES('Productivity_InYear'[Area]),
			"#P",[Productivity_InYear_Nopfp])
			)
			var res = SUMX(t,[#P])
			
			RETURN
			    res
			```
		lineageTag: c9e9f0ab-8daa-4747-b038-60c2b52aaf80

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

