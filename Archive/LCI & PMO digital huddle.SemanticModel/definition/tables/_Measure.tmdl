	measure 'PDCA_current month' = month(now())
		formatString: 0
		lineageTag: 2abeb077-2c4b-4377-b0f3-af963f44db51

	measure CF_FirstMondayofTheMonth = ```
			
			    IF(
			            DAY(TODAY()) >= 15 &&
			            DAY(TODAY()) <= 21 &&
			            WEEKDAY(TODAY(),3)=1,
			            "#00e945",
			            "#f5f5f5"
			    )
			```
		lineageTag: e7c692e2-c3f8-450f-b543-bd3058ea4306

		changedProperty = DisplayFolder

		changedProperty = Name

	measure CF_EveryMon = ```
			
			 IF(
			    WEEKDAY(TODAY(),2) =3,
			        "#00e945",
			        "#f5f5f5"
			 )
			```
		lineageTag: 2404faf4-f6ac-4f63-80f2-d72d85b12331

		changedProperty = DisplayFolder

		changedProperty = Name

	measure YTDTarget = ```
			
			Var LastMonth = MONTH(TODAY())-1
			var res = 
			 CALCULATE([TotalProductivityValue],'Productivity_InYear'[Value Type]="Target",'Productivity_InYear'[Month]<=LastMonth)
			RETURN
			    res
			```
		formatString: 0.0
		lineageTag: 0f182c5d-5151-4450-bf0f-830dd5a1dd1a

		changedProperty = Name

		changedProperty = FormatString

	measure TargetByArea2 = IF(NOT(ISFILTERED('Productivity_InYear'[Dept.])),  sum('Productivity_Target'[Fin Target]))
		lineageTag: 91e9fd65-2645-407c-be39-d1193eb97b5e

