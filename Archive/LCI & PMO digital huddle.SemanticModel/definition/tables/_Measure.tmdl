	measure CurrentColor = ```
			
			var color = MAX('OfficeStatus'[Color])
			var svg = 
			"data:image/svg+xml;utf8,<svg id='isaac' width='50' height = '50' xmlns='http://www.w3.org/2000/svg'>
			<text x='50%' y='50%' font-size='10' text-anchor='middle' dominant-baseline='central' fill='"&color&"'>■</text>
			</svg>"
			
			RETURN
			    svg
			```
		lineageTag: a8437510-b00c-4592-8556-2acbab8f5e39
		dataCategory: ImageUrl

		changedProperty = Name

		changedProperty = DataCategory

