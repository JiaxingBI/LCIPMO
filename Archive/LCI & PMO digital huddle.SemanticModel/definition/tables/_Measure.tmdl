	measure Safety_LTI = EXTERNALMEASURE("Safety_LTI", INTEGER, "DirectQuery 到 AS - JIA Digital huddle - Dataset1")
		formatString: 0
		lineageTag: a6ccffe8-15b1-4de2-8e87-d0ae2a05e29f
		sourceLineageTag: 08fd476f-6166-477e-b3da-f7f586f4eef2
