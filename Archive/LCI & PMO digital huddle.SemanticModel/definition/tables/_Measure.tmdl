		changedProperty = Name

	measure OffficeStatus_CurWeek = ```
			
			 var StartofThisWeek = MIN('CalendarLocal'[Date])
			 var EndofThisWeek = MAX('CalendarLocal'[Date])
			 var formatRange =  FORMAT(StartofThisWeek,"MM/DD") &"~"&FORMAT(EndofThisWeek,"MM/DD")
			 var Title = "Out of Office Status "
			 RETURN
			   Title&formatRange
			```
		lineageTag: 009b369e-fa25-4428-8eb6-89a5ff288927

		changedProperty = Name

