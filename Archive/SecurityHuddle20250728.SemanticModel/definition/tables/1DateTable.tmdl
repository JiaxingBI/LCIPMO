table 1DateTable
	lineageTag: 48fd2aa0-82d1-41c8-973b-e02e392f3458
	dataCategory: Time

	measure CurrentWeekOfYear = ```
			
			  CALCULATE(
			    MAX( '1DateTable'[WeekNum] ),
			    FILTER( '1DateTable', '1DateTable'[Date] = TODAY() )
			  )
			```
		formatString: 0
