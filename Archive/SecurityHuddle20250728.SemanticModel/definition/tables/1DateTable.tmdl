	column Day = [Date]
		formatString: dd
		lineageTag: b6fa9e44-38b8-4149-ae7d-a487d7f65f31
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	partition 1DateTable = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				  CALENDAR(
				    DATE(2024, 1, 1),                      // 起始日期
				    DATE( YEAR(TODAY()) + 3, 12, 31 )      // 结束日期：今年 + 3 年的 12‑31
				  ),                                       
				  "Year_num",        YEAR([Date]),             // 年份
				  "Month_num",       MONTH([Date]),            // 月份（数字）
				  "MonthName",   FORMAT([Date], "MMMM"),   // 月份（名称）
				  "Quarter",     "Q" & QUARTER([Date]),    // 季度
				  "Weekday",     WEEKDAY([Date], 2),       // 周几（1=周一…7=周日）
				  "WeekdayName", FORMAT([Date], "ddd"),    // 周几名称
				  "WeekNum",     WEEKNUM([Date], 2),        // 周一为每周第一天，1月1日所在周为第1周
				  "Day_num", DAY([Date])
				
				)
				```

	annotation PBI_Id = eabe374441a24c46865dcbd7a2fe4675

