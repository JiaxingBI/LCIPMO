	measure penetration_failed =
			
			CALCULATE(COUNT('Penetration Test'[Penetration_Result]),'Penetration Test'[Penetration_Result]="Failed",NOT(ISBLANK('Penetration Test'[Penetration_Result])))
		formatString: 0
		lineageTag: c9fd062d-5f16-41d5-bd10-90015c650d71

	measure penetration_pct =
			
			VAR fenzi=IF([penetration_failed]=0,[penetration_total],[penetration_failed])
			RETURN DIVIDE(fenzi,[penetration_total])
		formatString: 0%;-0%;0%
		lineageTag: bb880f1c-d6b3-454e-9da5-c6bd19bf14b7

	measure PDCA_update = ```
			
			var thisweekMonday= TODAY()
			                   - WEEKDAY(TODAY(), 2)  
			                   + 1
			VAR ThisWeekSunday= ThisWeekMonday + 6
			VAR RowsThisWeek =
			    CALCULATE(
			        COUNTROWS('Digital_Huddle PDCA'),
			        'Digital_Huddle PDCA'[Date_of_record] >= ThisWeekMonday,
			        'Digital_Huddle PDCA'[Date_of_record] <= ThisWeekSunday
			    )
			VAR Light=IF(
			    RowsThisWeek>0,
			    UNICHAR(128308),   // 
			    ""    // 🟢  
			)
			RETURN Light
			```
		lineageTag: 155fcad7-9561-4a19-bc8a-a5723b5affcd

