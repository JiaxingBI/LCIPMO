	measure pct_SMFSecurity =
			
			DIVIDE(
			  CALCULATE(
			    SUM('S&M mulfunction'[已完成]) + SUM('S&M mulfunction'[暂不维修]),
			    'S&M mulfunction'[Department] = "Security"
			  ),
			
			  CALCULATE(
			    SUM('S&M mulfunction'[已完成])
			    + SUM('S&M mulfunction'[暂不维修])
			    + SUM('S&M mulfunction'[维修进行中])
			    + SUM('S&M mulfunction'[重大维修]),
			    'S&M mulfunction'[Department] = "Security"
			  ),
			  0
			)
		formatString: 0%;-0%;0%
		lineageTag: 5874647d-7940-4134-845a-e3c2c16d47a9

	measure pct_SMFLAC =
			
			VAR T_S=FILTER('S&M mulfunction','S&M mulfunction'[Department]="LFAC")
			var numerator=SUMX(T_S,([已完成]+[暂不维修]+[维修进行中]+[重大维修])-([维修进行中]+[重大维修]))
			VAR denominator=SUMX(T_S,[已完成]+[暂不维修]+[维修进行中]+[重大维修])
			RETURN DIVIDE(numerator,denominator,0)
		formatString: 0%;-0%;0%
		lineageTag: acf63484-7197-4a5f-a0e5-12c215346bf0

	measure pct_SM_IT =
			
			VAR T_S=FILTER('S&M mulfunction','S&M mulfunction'[Department]="IT")
			var nominator=SUMX(T_S,([已完成]+[暂不维修]+[维修进行中]+[重大维修])-([维修进行中]+[重大维修]))
			VAR denominator=SUMX(T_S,[已完成]+[暂不维修]+[维修进行中]+[重大维修])
			RETURN DIVIDE(nominator,denominator,0)
		formatString: 0%;-0%;0%
		lineageTag: df4ad8c3-0b8b-49bb-b809-040b987e6b96

