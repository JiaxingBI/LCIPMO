	measure CurrentYearWeek = ```
			
			VAR _Year = YEAR( TODAY() ) 
			VAR _Week = WEEKNUM( TODAY(), 2 )              // 以周一为每周第一天
			VAR _WeekPadded =
			    IF( _Week < 10,
			        "0" & _Week,
			        _Week
			    )
			RETURN
			    _Year & "-W" & _WeekPadded
			
			```
		lineageTag: 8e4886ce-c655-4259-86c9-af1f8477c2d9

	measure IncidentFindingESPA1 =
			
			VAR T=FILTER(
			    'Incident Finding',
			    'Incident Finding'[FindingCategory]="Incident Finding (ESPA)"
			    &&
			    'Incident Finding'[ESPAFindingArea_num]=1
			    )
			VAR cnt=COUNTROWS(T)
			VAR res=IF(cnt=BLANK(),0,cnt)
			RETURN res
		formatString: 0
		lineageTag: 475d14ec-e9fa-4560-9e1b-3f105e188c3c

