table 1Title
	lineageTag: 7da9e1a3-0856-417a-b3a1-20780f5068aa

	measure IncifindESPA_IsUpdatedToday = ```
			var LastDataDate =
			CALCULATE(
			    MAX('Incident Finding'[Date]),
			    FILTER(
			        'Incident Finding',
			        'Incident Finding'[FindingCategory]="Incident Finding (ESPA)"
			    )
			)
			VAR Istoday= IF(
			    LastDataDate = TODAY(),
			    1,
			    0
			)
			VAR Light=SWITCH(
			    Istoday,
			    1, UNICHAR(128308),   // 
			    0,""    // 🟢  
			)
			RETURN Light&"Incident Finding(ESPA)"
			    
			```
		displayFolder: Title
		lineageTag: d19baac3-0c85-4574-85c9-a0ab8f495f70

