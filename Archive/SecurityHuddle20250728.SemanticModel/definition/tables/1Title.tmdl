	measure phsicaltraining_IsUpdatedToday = ```
			var LastDataDate = MAX('Phsical Training (Non-ESPA)'[训练时间])
			VAR Istoday= IF(
			    LastDataDate = TODAY(),
			    1,
			    0
			)
			VAR Light=SWITCH(
			    Istoday,
			    1, UNICHAR(128308),   // 
			    0,""    // 🟢  
			)
			var YTDactual=COUNTROWS(FILTER('Phsical Training (Non-ESPA)',NOT(ISBLANK('Phsical Training (Non-ESPA)'[体能通过率]))))
			
			var Target=COUNTROWS('Phsical Training (Non-ESPA)')
			
			RETURN Light&"体能训练(Non-ESPA)"&"  ("&YTDactual&"/"&Target&")"
			```
		displayFolder: Title
		lineageTag: df50b6ec-470f-49e2-9f4f-32c5e6f8424f

