	measure SecurityTraining_IsUpdatedToday = ```
			var LastDataDate =
			CALCULATE(
			    MAX('LEGO Security Training'[WeekStartDate]),
			    NOT(ISBLANK('LEGO Security Training'[Trainer]))
			)
			VAR Istoday= IF(
			        MONTH(LastDataDate)=MONTH(TODAY()),
			    1,
			    0
			)
			VAR Light=SWITCH(
			    Istoday,
			    1, UNICHAR(128308),   // 
			    0,""    // 🟢 
			)
			RETURN Light&"Security Training"
			    
			```
		displayFolder: Title
		lineageTag: 00beca8c-764a-4cdf-88f0-3c52a57e1e11

