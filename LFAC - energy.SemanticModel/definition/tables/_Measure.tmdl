table _Measure
	lineageTag: 9a4fdf82-2bb3-4004-82e3-0918cd931d84

	measure 'Eletricity Usage' = SUM('LFAC_Electricity400v'[Value])
		formatString: #,0.0
		lineageTag: e2d21b1e-cbdf-45ce-885f-c3d7b8242621

	measure Avg_Number = AVERAGEX( VALUES('LFAC_Electricity400v'[Date]),[Eletricity Usage])
		formatString: #,0
		lineageTag: c4b3dca4-63df-447c-9a76-da3c5b0dbab5

		annotation PBI_FormatHint = {"isDecimal":true}

	measure YTD_Number = ```
			
			 var numytd = CALCULATE([Eletricity Usage],DATESYTD('dDate'[Date]))
			 var res = IF(NOT(ISBLANK([Eletricity Usage])),numytd)
			 RETURN
			    res
			    
			```
		formatString: #,0
		lineageTag: d1ac11d6-2dab-44e9-b1ed-ff1b780e45a9

	measure 占比% =
			
			var SelectedTotal = CALCULATE([Eletricity Usage],ALLSELECTED('LFAC_Electricity400v'))
			var pct = DIVIDE([Eletricity Usage],SelectedTotal)
			RETURN
			    pct
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bda4d4e3-8737-4411-b56a-8cd0ccc345a9

	measure RunningTotal = ```
			
			CALCULATE([Eletricity Usage],FILTER(ALLSELECTED('LFAC_Electricity400v'), 'LFAC_Electricity400v'[Date]<=MAX('LFAC_Electricity400v'[Date])))
			
			```
		formatString: #,0
		lineageTag: 5a0ff0f1-a3ef-45ab-8f3b-45e59bd38a1a

	measure SelectedNow = IF( ISBLANK(SELECTEDVALUE('LFAC_Electricity400v'[SN])),TRUE(),FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 705380c8-9e6b-441b-8dc7-9996fe8f7070

	measure LabelAccum = ```
			SELECTEDVALUE('LFAC_Electricity400v'[使用区域]) & SELECTEDVALUE('LFAC_Electricity400v'[功能分类]) & SELECTEDVALUE('LFAC_Electricity400v'[SN]) & "用电累计" 
			```
		lineageTag: 47a8107a-9a86-47fe-92f6-476f39ee7cb1

	measure 20kvElectricyUsage = SUM('LFAC_20kv'[Value])
		formatString: #,0
		lineageTag: 82c4795b-9913-4bd6-8da1-8b922a80005c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 光伏发电量 = CALCULATE(SUM('LFAC_20kv'[Value]),'LFAC_20kv'[Cabinet]<>"20kV总进电")
		formatString: #,0.0
		lineageTag: 652b0650-69c2-40b3-860c-fc3ef58dbcb8

	measure Measure
		lineageTag: eca266f0-33c7-45a3-9329-cd6be0f7ba7b

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 20kv用电量 = CALCULATE(SUM('LFAC_20kv'[Value]),'LFAC_20kv'[Cabinet]="20kV总进电")
		formatString: #,0.0
		lineageTag: 1a528a66-3158-43bf-bc6d-7c511551a184

	measure AirCompressorElectrictyUsage = SUM('LFAC_Aircompressor_ElectricityUsage'[AirCompressor_PowerUsage])
		formatString: 0.0
		lineageTag: 03e363b2-d31b-4d8d-ab49-0226a29d0480

	measure 'PrevMonth Eletrcity' =
			
			var isDateSelected = SELECTEDVALUE('dDate'[YearMonth])
			var PreMonth = CALCULATE([20kv用电量],PREVIOUSMONTH('dDate'[Date]))
			var res = IF( not (ISBLANK(isDateSelected)),
			                        PreMonth,
			                         CALCULATE([20kv用电量], MONTH('LFAC_20kv'[Date])= MONTH(TODAY())-1)
			                         )
			RETURN
			    res
		lineageTag: 55f78600-a607-4f71-8ca6-5b53f45e81cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CurMonth Power Usage' =
			
			var isDateSelected = SELECTEDVALUE('dDate'[YearMonth])
			var res = IF( not (ISBLANK(isDateSelected)),
			                        CALCULATE([20kv用电量], MONTH('LFAC_20kv'[Date])= MAX('dDate'[Month])),
			                         CALCULATE([20kv用电量], MONTH('LFAC_20kv'[Date])= MONTH(TODAY()))
			                         )
			RETURN
			    res
		formatString: 0
		lineageTag: bd19954d-1fe4-40c1-8bd0-46b75f1427a2

	column Value
		lineageTag: 072c9930-b587-41c8-9744-6ebdedc3862f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measure = calculated
