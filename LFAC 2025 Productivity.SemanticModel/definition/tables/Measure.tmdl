	measure IL0_2Card = ```
			
			VAR MaxMonthVersion = [MaxVersion]
			VAR LastVersion     = [LastMonthInVersion]
			// 有月份筛选时
			VAR FutureTarget_Selected =
			    CALCULATE (
			        SUM ( LFAC[Value] ),
			        LFAC[Value Type] = "Target（MDKK）",
			        REMOVEFILTERS ( 'Month'[MonthNum] ),
			        LFAC[MonthNum] > MAX ( 'Month'[MonthNum] ),
			        LFAC[IL] IN { "IL0", "IL1", "IL2" }       
			    )
			
			VAR ToThisMonth_Selected =
			    IF ( MAX ( 'Month'[MonthNum] ) <= MONTH ( TODAY() ) - 1, FutureTarget_Selected )
			// 无月份筛选时
			VAR ActualYTD_AtLastMonth =
			    CALCULATE (
			        [ActualYTD],
			        REMOVEFILTERS ( 'Month' ),
			        'Month'[MonthNum] = LastVersion,
			        LFAC[Version] = MaxMonthVersion,
			        LFAC[IL] IN { "IL0", "IL1", "IL2" }    
			    )
			
			VAR FutureTarget_Default =
			    CALCULATE (
			        SUM ( LFAC[Value] ),
			        LFAC[Value Type] = "Target（MDKK）",
			        LFAC[Version] = MaxMonthVersion,
			        REMOVEFILTERS ( 'Month' ),
			        LFAC[MonthNum] > LastVersion,
			        LFAC[IL] IN { "IL0", "IL1", "IL2" } 
			    )
			RETURN
			IF (
			    ISFILTERED ( 'Month'[Month] ),
			    CALCULATE ( [ActualYTD], LFAC[IL] IN { "IL0", "IL1", "IL2" } ) + ToThisMonth_Selected,
			    ActualYTD_AtLastMonth + FutureTarget_Default
			)
			```
		lineageTag: d9a26751-872a-4792-a55f-7d68459548bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

