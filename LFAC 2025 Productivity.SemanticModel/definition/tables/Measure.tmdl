table Measure
	lineageTag: 13558b4e-230e-4d51-b44c-519cec223b6d

	measure Target =
			
			CALCULATE(
			    SUM('LFAC'[Value]),
			    'LFAC'[Value Type] = "Target（MDKK）",
			    LFAC[Version] = MAX(LFAC[Version])
			)
		lineageTag: 2b6b8dbd-692b-411e-9c57-e281eb629bd6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'InYearBenefit Color' =
			
			IF (
			    [InYearBenefit1] < [Target],
			    "#E63946",
			    "#01a522"
			)
		lineageTag: 05d3010c-bd71-4956-9639-6800e85f7a60

	measure LastMonthInVersion =
			
			VAR MaxVersion =
			    CALCULATE(
			        MAX(LFAC[Version]),
			        ALL(LFAC)
			    )
			RETURN
			MAXX(
			    FILTER(
			        ALL(LFAC),
			        LFAC[Version] = MaxVersion
			        && LFAC[Value Type] = "Actual（MDKK)"
			        && NOT(ISBLANK(LFAC[Value]))   -- 忽略空值
			        && LFAC[Value] <> 0            -- 忽略值为0
			    ),
			    LFAC[MonthNum]
			)
		lineageTag: 51799ecc-2fa9-484a-80e0-2420763973c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure var = [InYearBenefit1] - [Target]
		lineageTag: c8f880f3-457f-4a8e-b5c1-1d5aaef3509e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'var Color' =
			
			IF (
			    [var] < 0,
			    "#E63946",
			    "#01a522"
			)
		lineageTag: d7232350-b1f9-4732-8660-e845239fa753

	measure InYearBenefit = ```
			
			VAR FutureTarget =
			    CALCULATE (
			        SUM ( LFAC[Value] ),
			        LFAC[Value Type] = "Target（MDKK）" ,
			        REMOVEFILTERS('Month'[MonthNum]),
			        LFAC[MonthNum]>MAX('Month'[MonthNum])
			    )
			VAR tothismonth=IF(
			    MAX('Month'[MonthNum])<=MONTH(TODAY())-1,
			    FutureTarget,
			    BLANK()
			)
			RETURN
			    [ActualYTD] + tothismonth
			
			```
		lineageTag: 938ed9c5-ee27-4a2b-98fa-efe032aaec9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ActualYTD =
			
			var YTDacutal = CALCULATE(
			    SUM(LFAC[Value]),
			    LFAC[Value Type]="Actual（MDKK)",
			    FILTER(
			        ALL(LFAC[MonthNum]),
			        LFAC[MonthNum] <= MAX('Month'[MonthNum])
			    )
			)
			return IF(
			    MAX('Month'[MonthNum])<=MONTH(TODAY())-1,
			    YTDacutal,
			    BLANK()
			)
		lineageTag: c1e19e85-ca0c-4704-8f9d-0e7f26e1b86b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TargetYTD =
			
			var YTDacutal = CALCULATE(
			    SUM(LFAC[Value]),
			    LFAC[Value Type]="Target（MDKK）",
			    FILTER(
			        ALL(LFAC[MonthNum]),
			        LFAC[MonthNum] <= MAX('Month'[MonthNum])
			    )
			)
			return IF(
			    MAX('Month'[MonthNum])<=MONTH(TODAY())-1,
			    YTDacutal,
			    BLANK()
			)
		lineageTag: ab3f0fcd-4251-415b-9b19-bebb4f9a5098

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FutureTarget_Default = ```
			
			VAR MaxVersion = [MaxVersion]
			VAR LastMonthInVersion = [LastMonthInVersion]
			RETURN    
			    CALCULATE (
			        SUM ( LFAC[Value] ),
			        LFAC[Value Type] = "Target（MDKK）",
			        LFAC[Version] = MaxVersion,
			        LFAC[MonthNum] > LastMonthInVersion
			    )
			```
		formatString: 0.0000
		lineageTag: e31d44af-71ac-4005-82c0-04f2d43f3088

