	column Status
		lineageTag: 31fc9a43-6b27-48c1-b8dd-9a36674141ee
		summarizeBy: none
		isNameInferred
		sourceColumn: [Status]

		annotation SummarizationSetBy = Automatic

	partition ProjectStatus = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				SUMMARIZE (
				    'Overall tracker',
				    'Overall tracker'[Project name],
				    'Overall tracker'[Category],
				    'Overall tracker'[Dept],
				    'Overall tracker'[Sites],
				    'Overall tracker'[IL],
				    'Overall tracker'[Project leader]
				),
				"Status",
				VAR T = CALCULATE(
				        SUM('Overall tracker'[Value]),
				        'Overall tracker'[Value Type]="Target" ,
				        'Overall tracker'[MonthNum]<=MONTH(TODAY())
				)
				VAR A = CALCULATE(
				        SUM('Overall tracker'[Value]),
				        'Overall tracker'[Value Type]="Actual" ,
				        'Overall tracker'[MonthNum]<=MONTH(TODAY())
				        )
				 RETURN
				        IF(
				            OR( ISBLANK(T), T = 0 ),
				            "🟡",
				            IF( T <= A, "🟢", "🔴" )
				        )
				)

	annotation PBI_Id = 834980ee66784d05a3d242a10317b3df

