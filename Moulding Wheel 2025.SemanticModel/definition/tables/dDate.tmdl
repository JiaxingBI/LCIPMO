		sourceColumn: [Day_num]

		annotation SummarizationSetBy = Automatic

	partition dDate = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				  CALENDAR(
				    DATE(2024, 1, 1),                      // 起始日期
				    DATE( YEAR(TODAY()) + 3, 12, 31 )      // 结束日期：今年 + 3 年的 12‑31
				  ),                                       
				  "Year_num",        YEAR([Date]),             // 年份
				  "Month_num",       MONTH([Date]),            // 月份（数字）
				  "MonthName",   FORMAT([Date], "MMMM"),   // 月份（名称）
				  "Quarter",     "Q" & QUARTER([Date]),    // 季度
				  "Weekday",     WEEKDAY([Date], 2),       // 周几（1=周一…7=周日）
				  "WeekdayName", FORMAT([Date], "ddd"),    // 周几名称
				  "WeekNum",     WEEKNUM([Date], 2),        // 周一为每周第一天，1月1日所在周为第1周
				  "Day_num", DAY([Date])
				
				)
				```

	annotation PBI_Id = de9bcc4294374b7d840f1ce411751e56

