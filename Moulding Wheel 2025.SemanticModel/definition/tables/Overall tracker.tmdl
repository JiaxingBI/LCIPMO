				    #"Unpivoted Columns" = Table.UnpivotOtherColumns(#"Promoted Headers", {"Area", "Dept.", "Project name", "Project leader", "Cost bucket", "Category", "Value Type", "YTD Saving#(lf)(m DKK)", "Total Target#(lf)(m DKK)", "IL", "Carry over average saving/month to 2025", "Carry over months in 2025", "ID_General", "Comments", "NO"}, "Attribute", "Value"),
				    #"Renamed Columns" = Table.RenameColumns(#"Unpivoted Columns",{{"Attribute", "Month"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns",{{"Month", Int64.Type}, {"Value", type number}}),
				    #"Replaced Errors" = Table.ReplaceErrorValues(#"Changed Type1", {{"Value", 0}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Replaced Errors","Packing","NYI",Replacer.ReplaceText,{"Area"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","Processing","KOM",Replacer.ReplaceText,{"Area"}),
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value1","LFAC","LOM",Replacer.ReplaceText,{"Area"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value4","Supporting","LOM",Replacer.ReplaceText,{"Area"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","Moulding","JIA",Replacer.ReplaceText,{"Area"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value3",{{"Area", "Sites"}, {"Dept.", "Dept"}}),
				    #"Replaced Values"= Table.ReplaceValue(
				    #"Renamed Columns1",
				    each [Dept],
				    each List.ReplaceMatchingItems(
				        {[Dept]}, 
				        {{"Management", "Moulding"}, {"Processing", "HBW"},{"Finalpack", "Moulding"},{"Maintenance", "Machine Maintenance"},{"MWH", "Mould Maint"},{"NPI", "MPE&E"},{"Others", "Production"},{"Prepack", "Repair & Maintenance"},{"LFAC", "Production"}}
				    ){0},
				    Replacer.ReplaceValue,
				    {"Dept"}
				),
				    #"Renamed Columns2" = Table.RenameColumns(#"Replaced Values",{{"Month", "MonthNum"}}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Renamed Columns2", "IL", "IL - Copy"),
				    #"Renamed Columns3" = Table.RenameColumns(#"Duplicated Column",{{"IL - Copy", "IL_"}}),
				    #"Extracted Text Before Delimiter" = Table.TransformColumns(#"Renamed Columns3", {{"IL_", each Text.BeforeDelimiter(_, "-"), type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Extracted Text Before Delimiter",{{"IL_", Text.Clean, type text}})
				in
				    #"Cleaned Text"
				```

