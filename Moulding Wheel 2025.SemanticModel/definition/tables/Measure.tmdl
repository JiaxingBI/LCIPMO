	measure YearMonthCard =
			
			VAR curYear = YEAR(TODAY())
			VAR curMonth = MONTH(TODAY())
			VAR targetYear = IF(curMonth = 1, curYear - 1, curYear)
			VAR targetMonth = IF(curMonth = 1, 12, curMonth - 1)
			VAR targetDate = DATE(targetYear, targetMonth, 1)
			RETURN
			    targetYear & "-" & FORMAT(targetDate, "mmm")
		lineageTag: 7a8d174b-1a55-4496-a8fa-d474ded4746f

	measure 'A vs T_Value' =
			
			IF(
			    MAX('Overall tracker'[Value Type]) = "Actual",
			    SUM('Overall tracker'[Value]),
			    VAR SelectedMonths = VALUES('dDate'[Month_num])
			    VAR MonthsCountAll = COUNTROWS( ALL( 'dDate'[Month_num] ) )
			    VAR MonthsCountSel = COUNTROWS( SelectedMonths )
			    VAR IsMonthFiltered = MonthsCountSel > 0 && MonthsCountSel < MonthsCountAll
			    RETURN
			        IF(
			            IsMonthFiltered,
			            CALCULATE(
			                SUM('Overall tracker'[Value]),
			                'Overall tracker'[Value Type] = "Target",
			                TREATAS( SelectedMonths, 'Overall tracker'[MonthNum] )
			            ),
			            [Target_JIA] + [Target_KOM] + [Target_LOM] + [Target_NYI]
			        )
			)
		lineageTag: 63eef17a-c733-4f9c-b726-0159b41302c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Count_Projects_Green = ```
			
			SUMX(
			    VALUES('Overall tracker'[Project name]),
			    VAR ThisProject = SELECTEDVALUE('Overall tracker'[Project name])
			    VAR T = CALCULATE(
			                SUM('Overall tracker'[Value]),
			                'Overall tracker'[Value Type] = "Target",
			                'Overall tracker'[Project name] = ThisProject
			            )
			    VAR A = CALCULATE(
			                SUM('Overall tracker'[Value]),
			                'Overall tracker'[Value Type] = "Actual",
			                'Overall tracker'[Project name] = ThisProject
			            )
			    RETURN
			        IF( NOT( ISBLANK(T) ) && T <> 0 && A >= T, 1, 0 )
			)
			
			```
		formatString: 0
		lineageTag: 878682fe-29b0-4187-9043-3d90be5fa6f0

