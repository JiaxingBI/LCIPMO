	measure Sites_TargetValue =
			
			VAR SiteVal = SELECTEDVALUE ( 'ProjectStatus'[Sites], "ALL" )
			RETURN
			SWITCH (
			    SiteVal,
			    "JIA", 8,
			    "KOM", 4,
			    "LOM", 3,
			    "NYI", 9,
			    "ALL", 8 + 4 + 3 + 9
			)
		formatString: 0
		lineageTag: 39367248-037a-4a11-97bf-04d04488fc8c

	measure 'Site Display1' =
			
