	measure Actual_MonthTrend =
			
			VAR valuess=
			CALCULATE(
			    SUM('Overall tracker'[Value]),
			    'Overall tracker'[Value Type] = "Actual"
			)
			VAR res=
			IF(
			    valuess=0,
			    BLANK(),
			    valuess
			)
			VAR finalres=
			IF(
			    MAX('Overall tracker'[MonthNum])>MONTH(TODAY())-1,
			    res=0,
			    res
			)
			RETURN finalres
