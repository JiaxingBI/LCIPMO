	measure Productivity_InYear =
			
			VAR YTDActual = CALCULATE([Actual_Value],'Overall tracker'[MonthNum]<=MONTH(TODAY())-1)
			VAR FutureTarget = CALCULATE([Target_Value],'Overall tracker'[MonthNum]>MONTH(TODAY())-1)
			VAR res = YTDActual+FutureTarget
			RETURN res
		formatString: 0.0
		lineageTag: 587bf0d4-7640-4006-9cf2-5af122531f35

