	measure Actual_CurrentMonth =
			
			VAR curYear  = YEAR ( TODAY() )
			VAR curMonth = MONTH ( TODAY() )
			VAR lastmonth=MONTH ( TODAY() )-1
			RETURN
			CALCULATE (
			    [Actual],
			    FILTER (
			        'Overall tracker',
			        'Overall tracker'[MonthNum]= lastmonth
			    )
			)
		formatString: 0.00
		lineageTag: a2663ad8-7d6f-46bb-bc45-f306b4f19cd1

	measure GaugeColor = ```
			
			VAR Ratio = DIVIDE([Actual_Value], [Target_Value], 0)
			RETURN
			SWITCH(
			    TRUE(),
			    Ratio <= 0.5, "#dd1a22", 
			    Ratio < 1, "#fed403",
			    "00ae4d"
			)
			
			```
		lineageTag: 5b24f4ce-180d-4b02-a63a-fe581a56b3d2

	measure GaugeRGBColor = ```
			
			VAR Ratio = DIVIDE ( [Actual_Value], [Target_Value], 0 )
			
			-- 红色 "#dd1a22"
			VAR Red_Red = 221
			VAR Green_Red = 26
			VAR Blue_Red = 34
			
			-- 黄色 "#fed403"
			VAR Red_Yellow = 254
			VAR Green_Yellow = 212
			VAR Blue_Yellow = 3
			
			-- 绿色 "#00ae4d"
			VAR Red_Green = 0
			VAR Green_Green = 174
			VAR Blue_Green = 77
			
			-- 深绿色 "#007035"
			VAR Red_DarkGreen = 0
			VAR Green_DarkGreen = 112
			VAR Blue_DarkGreen = 53
			
			-- 超额比率（0~1）
			VAR ExtraRatio = MIN ( MAX ( Ratio - 1, 0 ), 1 )
			
			-- 颜色逻辑
			VAR ColorRGB =
			    IF (
			        Ratio <= 0.5,
			        // 红 → 黄
			        "rgb("
			            & ROUND ( Red_Red + ( Red_Yellow - Red_Red ) * ( Ratio / 0.5 ), 0 ) & ","
			            & ROUND ( Green_Red + ( Green_Yellow - Green_Red ) * ( Ratio / 0.5 ), 0 ) & ","
			            & ROUND ( Blue_Red + ( Blue_Yellow - Blue_Red ) * ( Ratio / 0.5 ), 0 ) & ")",
			        IF (
			            Ratio < 1,
			            // 黄 → 偏黄的黄绿色（只往绿色靠 30%）
			            "rgb("
			                & ROUND ( Red_Yellow + ( (Red_Green - Red_Yellow) * ( (Ratio - 0.5) / 0.5 ) * 0.3 ), 0 ) & ","
			                & ROUND ( Green_Yellow + ( (Green_Green - Green_Yellow) * ( (Ratio - 0.5) / 0.5 ) * 0.3 ), 0 ) & ","
			                & ROUND ( Blue_Yellow + ( (Blue_Green - Blue_Yellow) * ( (Ratio - 0.5) / 0.5 ) * 0.3 ), 0 ) & ")",
			            IF (
			                Ratio = 1,
			                // 正好达到目标 = 亮绿色
			                "rgb(" & Red_Green & "," & Green_Green & "," & Blue_Green & ")",
			                // 超额部分：绿色 → 深绿色
			                "rgb("
			                    & ROUND ( Red_Green + ( Red_DarkGreen - Red_Green ) * ExtraRatio, 0 ) & ","
			                    & ROUND ( Green_Green + ( Green_DarkGreen - Green_Green ) * ExtraRatio, 0 ) & ","
			                    & ROUND ( Blue_Green + ( Blue_DarkGreen - Blue_Green ) * ExtraRatio, 0 ) & ")"
			            )
			        )
			    )
			RETURN
			ColorRGB
			
			```
		lineageTag: 5a0ab325-f21d-46c3-ad3b-c5b99f7ae2f3

