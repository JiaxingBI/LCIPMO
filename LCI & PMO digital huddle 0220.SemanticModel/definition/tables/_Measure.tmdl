	measure Details = ```
			
			var TotalSavingInIdentity = sum('Table_Productivity_Saving Overall'[Saving in identify])
			var TotalPfP= CALCULATE(SUM('Table_Productivity_Saving Target'[In Year Benefit]),'Table_Productivity_Saving Target'[Area]="PfP")
			var total = TotalSavingInIdentity+TotalPfP
			var Target = [Target]
			var diff = total-Target
			var res = IF(diff>0, "▲" & FORMAT(diff,"#.00"),"▼"&FORMAT(diff,"#.00"))
			RETURN
			    diff
			
			```
