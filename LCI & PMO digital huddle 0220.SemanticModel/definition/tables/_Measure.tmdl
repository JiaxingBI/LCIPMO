	measure Productivity_2025 =
			
			
			Var LastMonth = MONTH(TODAY())-1
			var YTDActual = CALCULATE([TotalProductivityValue],'2025ProductivityTracker'[Value Type]="Actual",'2025ProductivityTracker'[Month]<=LastMonth)
			var FutureTarget = CALCULATE([TotalProductivityValue],'2025ProductivityTracker'[Value Type]="Target",'2025ProductivityTracker'[Month]>LastMonth)
			var res = YTDActual+FutureTarget
			RETURN
			res
		formatString: 0.00
		displayFolder: Local Measure\Cards
		lineageTag: 5f39829e-3e99-4bc5-ae59-75c3a0ca067a

		changedProperty = Name

		changedProperty = FormatString

	measure Productivity_Gap = [Productivity_2025]-[Target]
		formatString: 0.00
		displayFolder: Local Measure\Cards
		lineageTag: 3d6d66ad-5471-4f6d-a921-ca4ba66a7fdf

		changedProperty = Name

		changedProperty = FormatString

	measure Exercise_Actual = SUM('ExerciseTime'[Actual])
		formatString: #,0
		displayFolder: Local Measure\Excercise
		lineageTag: bf594884-1710-40e4-a2e5-4ed676eafc98

		changedProperty = Name

		changedProperty = FormatString

	measure Exercise_Target = SUM('ExerciseTime'[Target])
		formatString: #,0
		displayFolder: Local Measure\Excercise
		lineageTag: 1f28c56c-baaf-4aaa-bc73-d604d0e74db7

		changedProperty = Name

		changedProperty = FormatString

	measure Exercise_LastWeekNum = WEEKNUM(NOW())-2
		formatString: 0
		displayFolder: Local Measure\Excercise
		lineageTag: 3f99133c-69a5-4c87-8b11-668643493f27

		changedProperty = Name

	measure Exercise_LastWeekActual = ```
			
			---var lastWeekNUm = [Exercise_LastWeekNum]
			---var res = 
			  ---  CALCULATE([Exercise_Actual],ExerciseTime[Week]=lastWeekNUm)
			var placeholder =0
			RETURN
			    placeholder
			```
		displayFolder: Local Measure\Excercise
		lineageTag: bd591bc4-a084-43cf-8e67-1d55651a5bbd

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Exercise_LastWeekTarget = ```
			
			var lastWeekNUm = [Exercise_LastWeekNum]
			var res = 
			    CALCULATE([Exercise_Target],ExerciseTime[Week]=lastWeekNUm)
			RETURN
			    res
			```
		formatString: 0
		displayFolder: Local Measure\Excercise
		lineageTag: 8046b6f8-fbf7-4d09-801c-29a8a85bff0b

		changedProperty = Name

	measure Exercise_Title_WeeklyReview = ```
			
			    var numLastWeek = [Exercise_LastWeekNum]
			    var totalActual = [Exercise_LastWeekActual]
			    var TotalHours = FORMAT(DIVIDE([Exercise_Actual],60),"#0.0")
			RETURN
			    "In WK" & numLastWeek & ",  LCI Team has spent " & totalActual &"mins for Health Builing, and  "& TotalHours &"hrs this year in total" 
			```
		displayFolder: Local Measure\Excercise
		lineageTag: 1490d930-da37-4d93-881d-630062dde5b9

		changedProperty = Name

	measure 提示字符 =
			
			var TotalSavingInIdentity = sum('Table_Productivity_Saving Overall'[Saving in identify])
			var TotalPfP= CALCULATE(SUM('Table_Productivity_Saving Target'[In Year Benefit]),'Table_Productivity_Saving Target'[Area]="PfP")
			RETURN
			    FORMAT(TotalSavingInIdentity,"#.00")+TotalPfP & UNICHAR(10) & "(PFP:" & TotalPfP &")"
		displayFolder: Local Measure\Cards
		lineageTag: d6e76139-0bdd-43a7-b587-ec78a9d734c4

		changedProperty = IsHidden

	measure TotalPfP = 0
		formatString: 0
		displayFolder: Local Measure\Cards
		lineageTag: 73a81d0a-4c54-489c-a0d2-bf1f706e7f43

		changedProperty = Name

	measure Target = 24
		formatString: 0
		displayFolder: Local Measure\Cards
		lineageTag: 9d775002-bbfb-4408-840b-47ee74b5e599

		changedProperty = Name

	measure Exercise_Weekly_Average = ```
			
			var AvgMins = AVERAGEX('ExerciseTime',[Exercise_Actual])
			var WeeklyHrs = TRUNC(DIVIDE(AvgMins,60))
			var WeeklyMins = FORMAT(AvgMins,"00")- FORMAT(WeeklyHrs*60,"00")
			RETURN
			    WeeklyHrs & "hrs : " & WeeklyMins & "mins"
			
			```
		displayFolder: Local Measure\Excercise
		lineageTag: fd5246cf-28e3-411f-8df5-75d61f96f038

		changedProperty = Name

	measure Exercise_YTDTotal_hrs =
			
			var YTDEXE = DIVIDE([Exercise_Actual],60)
			var YTDHrs = TRUNC(YTDEXE)
			var YTDMins = FORMAT([Exercise_Actual],"00")- FORMAT(YTDHrs*60,"00")
			RETURN
			    YTDHrs& "hrs: "& YTDMins& "mins"
