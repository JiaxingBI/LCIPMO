	measure Productivity_2025-as =
			
			var varActual = CALCULATE([TotalProductivityValue],'2025ProductivityTracker'[Value Type]="Actual")
			var varTarget = CALCULATE([TotalProductivityValue],'2025ProductivityTracker'[Value Type]="Target")
			Var LastMonth = MONTH(TODAY())-1
			var YTDActual = CALCULATE(varActual,'2025ProductivityTracker'[Month]<=LastMonth)
			var FutureTarget = CALCULATE(varTarget,'2025ProductivityTracker'[Month]>1)
			var res = YTDActual+FutureTarget
			RETURN
			FutureTarget
		formatString: 0.0000
		lineageTag: 64a67296-0459-481f-920a-4a3e90a2db07

		changedProperty = Name

		changedProperty = FormatString

