	measure IL0-2 = ```
			
			var currentMonth = MAX('Month'[MonthNum])
			VAR MaxMonthVersion = [MaxVersion]
			//Month Selected
			var actualYTD = 
			    CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Actual"&&OverallTracker[IL] IN { "IL0 - Identified", "IL1 - Validated", "IL2 - Planned" },
			                OverallTracker[MonthNum]<=currentMonth
			    )
			var futureTarget = 
			   CALCULATE(
			      CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Target"&&OverallTracker[IL] IN { "IL0 - Identified", "IL1 - Validated", "IL2 - Planned" },
			                OverallTracker[MonthNum]>currentMonth
			    )
			   )
			// No Selected
			var _ActualYTD = 
			    CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Actual"&&OverallTracker[Version] = MaxMonthVersion&&OverallTracker[IL] IN { "IL0 - Identified", "IL1 - Validated", "IL2 - Planned" },
			                OverallTracker[MonthNum]<=MaxMonthVersion
			    )
			var _FutureTarget = 
			   CALCULATE(
			      CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Target"&&OverallTracker[Version] = MaxMonthVersion&&OverallTracker[IL] IN { "IL0 - Identified", "IL1 - Validated", "IL2 - Planned" },
			                OverallTracker[MonthNum]>MaxMonthVersion
			    )
			   )
			
			RETURN
			IF (
			    ISFILTERED ( 'Month'[Month] ),
			    actualYTD  + futureTarget,
			    _ActualYTD  + _FutureTarget 
			)
			
			```
		lineageTag: ae74a0ea-4a60-4e37-a85a-52f914b81a63

