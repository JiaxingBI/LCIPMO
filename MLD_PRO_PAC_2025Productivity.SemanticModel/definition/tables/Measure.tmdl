	measure InYearBenefit = ```
			
			var currentMonth = MAX('Month'[MonthNum])
			VAR MaxMonthVersion = [MaxVersion]
			//Month Selected
			var actualYTD = 
			    CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Actual"&&
			                OverallTracker[MonthNum]<=currentMonth
			    )
			var futureTarget = 
			   CALCULATE(
			      CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Target"&&
			                OverallTracker[MonthNum]>currentMonth
			    )
			   )
			// No Selected
			var _ActualYTD = 
			    CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Actual"&&OverallTracker[Version] = MaxMonthVersion,
			                OverallTracker[MonthNum]<=MaxMonthVersion
			    )
			var _FutureTarget = 
			   CALCULATE(
			      CALCULATE(
			        SUM(OverallTracker[Value]),
			                OverallTracker[Value Type]="Target"&&OverallTracker[Version] = MaxMonthVersion,
			                OverallTracker[MonthNum]>MaxMonthVersion
			    )
			   )
			
			RETURN
			IF (
			    ISFILTERED ( 'Month'[Month] ),
			    actualYTD  + futureTarget,
			    _ActualYTD  + _FutureTarget 
			)
			
			```
		lineageTag: 761a0cb4-15df-4a89-ab36-fac0e4ac4206

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ActualYTD = ```
			
