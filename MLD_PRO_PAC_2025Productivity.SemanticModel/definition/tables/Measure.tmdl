	measure ActualYTD_IL02 =
			
			VAR CurrMonth = [CurrentMonth]
			RETURN
			CALCULATE(
			    SUM(OverallTracker[Value]),
			    OverallTracker[Value Type] = "Actual"&&
			    OverallTracker[Version] = CurrMonth,
			    FILTER(
			        ALL(OverallTracker),
			        OverallTracker[MonthNum] <= CurrMonth &&
			        OverallTracker[IL] IN { "IL0 - Identified", "IL1 - Validated", "IL2 - Planned" }
			    )
			)
		lineageTag: d5c0fa85-2379-4a90-a04b-0ad3784c02e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

