	measure CF-Diff =
			
			var formatdiff = FORMAT([Diff],"0.0")
			var res  = IF([Diff]>=0,  "▲ "& formatdiff, "▼ " &formatdiff)
			RETURN
			    res
		lineageTag: 7119d091-63fd-4caf-966e-851cdac29b9f

