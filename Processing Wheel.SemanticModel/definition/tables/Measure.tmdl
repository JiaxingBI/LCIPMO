	measure CellColor2 = ```
			
			VAR EvalWeek = SELECTEDVALUE(dimWeek[WeekNum]) 
			VAR PlanWk = MAX('DetailedProjects'[WKPlan])
			VAR ActualWk = MAX('DetailedProjects'[WkActual])
			VAR TodayWk = WEEKNUM(TODAY())
			VAR SquareFill =
			 IF(ISBLANK(ActualWk),
			        SWITCH(TRUE(),
			            EvalWeek<TodayWk,IF(EvalWeek<= TodayWk ,"#9bc2e6","#00af4d"),
			            EvalWeek>=TodayWk,"White"
			            )
			            ,
			        SWITCH(TRUE(),
			        EvalWeek<TodayWk,IF(EvalWeek<= ActualWk,"#9bc2e6","#00af4d"),
			        EvalWeek>=TodayWk,"White"
			)
			 )
			var LineOpac = IF(EvalWeek=TodayWk,1,0)
			var svg = "data:image/svg+xml;utf8,<svg width='40' height='40' xmlns='http://www.w3.org/2000/svg'>
			<rect width='40' height='38' fill= '"&SquareFill&"' />
			<line x1='0' x2='0' y2='40' stroke='red' stroke-width='15' stroke-opacity='"&LineOpac&"' />
			</svg>
			"
			RETURN
			svg
			```
		lineageTag: 814bcc72-98b7-4443-9da7-752624db6fbf
		dataCategory: ImageUrl

	measure Site_SAT =
			/* Phase 1: Only consider SAT timing */
			var errorLight = COUNTROWS( FILTER('DetailedProjects', 'DetailedProjects'[_Phase] = "Phase 1" && 'DetailedProjects'[Status]="🔴"))
			var res = IF(errorLight>0,"🔴","🟢")
			RETURN
			    res
		lineageTag: 4a17b430-d0cb-42be-acc8-d57247243026

	measure Site_Imp =
			/* Phase 1: Only consider SAT timing */
			var errorLight = COUNTROWS( FILTER('DetailedProjects', 'DetailedProjects'[_Phase] = "Phase 2" && 'DetailedProjects'[Status]="🔴"))
			var res = IF(errorLight>0,"🔴","🟢")
			RETURN
			    res
		lineageTag: aca6516f-271a-46a2-a804-b5759e03f4e3

