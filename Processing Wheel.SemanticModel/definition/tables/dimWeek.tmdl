	column MonthNum
		formatString: 0
		lineageTag: 150e7b4d-e84c-4a9e-8b26-8fc378498ccd
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MonthNum]

		annotation SummarizationSetBy = Automatic

	column 'Week-8 to YearEnd' = ```
			
			VAR curr = WEEKNUM(TODAY(),21)
			VAR startWeek = IF(curr - 8 > 0, curr - 8, 1)
			VAR selectedWeek = [WeekNum]
			var res = 
			IF(selectedWeek >= startWeek && selectedWeek <= 52, 1, 0)
			RETURN
			    res
			```
		formatString: 0
		lineageTag: 2dd89d04-19f0-404b-850e-1530e52ea66f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	hierarchy 'Month Hierarchy'
		lineageTag: 986a38d8-3a93-4bc3-b585-51a8af27f417

		level _
			lineageTag: 13a938fd-d4dd-431c-a689-a68106af779d
			column: Month

		level WeekNum
			lineageTag: 693ea266-d539-425b-9ce5-9105260a7da9
			column: WeekNum

	partition dimWeek = calculated
		mode: import
		source = ```
				
				VAR BaseDate = DATE(2024, 12, 30) // 
				VAR res = 
				SELECTCOLUMNS(
				    GENERATESERIES(1, 52, 1),  
				    "WeekNum", [Value],
				    "WeekStart", BaseDate + ([Value] - 1) * 7,
				    "WeekEnd", BaseDate + [Value] * 7 - 1,
				    "Month", FORMAT(BaseDate + ([Value] - 1) * 7+3, "MMM"),
				    "MonthNum", MONTH(BaseDate + ([Value] - 1) * 7+3)
				)
				RETURN
				    res
				```

	annotation PBI_Id = eeb2340daec043a0b7c92d646cfaa494

