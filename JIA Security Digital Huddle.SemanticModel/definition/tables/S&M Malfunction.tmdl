table 'S&M Malfunction'
	lineageTag: d3de9365-5674-40c5-8bd5-93f6623911e6

	measure NewAddYesterday =
			
			IF(
			    SUM('S&M Malfunction'[New])<>0,
			    SUM('S&M Malfunction'[New]),
			    0
			)
