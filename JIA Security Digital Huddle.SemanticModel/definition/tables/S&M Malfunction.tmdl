	column MonthNumber = ```
			
			  SWITCH(
			    [Month],
			    "Jan",   1,
			    "Feb",   2,
			    "Mar",   3,
			    "Apr",   4,
			    "May",   5,
			    "Jun",   6,
			    "Jul",   7,
			    "Aug",   8,
			    "Sep",   9,
			    "Oct",  10,
			    "Nov",11,
			    "Dec",12,
			    BLANK()
			  )
			```
		formatString: 0
		lineageTag: 592f3e44-f3e6-4a15-a83f-357802e74bb6
