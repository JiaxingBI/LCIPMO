	measure CardA_Display =
			
			VAR selCount =
			    COUNTROWS( VALUES( 'dDate'[IsCurrentWeek] ) )
			VAR totalCount =
			    COUNTROWS( ALL( 'dDate'[IsCurrentWeek] ) )
			VAR selText =
			    CONCATENATEX(
			        VALUES( 'dDate'[IsCurrentWeek] ),
			        'dDate'[IsCurrentWeek],
			        ", "
			    )
			RETURN
			IF(
			    totalCount = 0,
			    BLANK(),
			    IF(
			        selCount = totalCount,
			        "All",
			        selText
			    )
			)
		lineageTag: ed95f949-6f45-443a-abcc-2e925a1019e3

