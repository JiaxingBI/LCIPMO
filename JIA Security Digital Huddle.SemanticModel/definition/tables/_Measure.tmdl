	measure '% SMF' =
			
			DIVIDE(
			  CALCULATE(
			    SUM('S&M Malfunction'[Done]) + SUM('S&M Malfunction'[Pending])
			  ),
			
			  CALCULATE(
			    SUM('S&M Malfunction'[Done])
			    + SUM('S&M Malfunction'[Pending])
			    + SUM('S&M Malfunction'[Ongoing])
			    + SUM('S&M Malfunction'[New])
			  ),
			  0
			)
		formatString: 0%;-0%;0%
		lineageTag: 5874647d-7940-4134-845a-e3c2c16d47a9

