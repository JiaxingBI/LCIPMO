	measure 'JIA Accumulated Days without LTI' =
			
			var LatestIssueDate =
			CALCULATE(
			    MAX('Digital_Huddle KPI_data'[Date]),
			    FILTER('Digital_Huddle KPI_data','Digital_Huddle KPI_data'[Actual_value]>=3)
			    )
			var AdjustedStartDate =
			    IF(
			        ISBLANK(LatestIssueDate),
			        MIN('Digital_Huddle KPI_data'[Date]),
			        LatestIssueDate)
			var CountDays =
			    DATEDIFF(AdjustedStartDate,TODAY(),DAY)
			RETURN
