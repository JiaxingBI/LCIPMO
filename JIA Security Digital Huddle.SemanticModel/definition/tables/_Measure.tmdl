	measure CurrentYearWeek = ```
			
			VAR _Year = YEAR( TODAY() ) 
			VAR _Week = WEEKNUM( TODAY(), 2 )              // 以周一为每周第一天
			VAR _WeekPadded =
			    IF( _Week < 10,
			        "0" & _Week,
			        _Week
			    )
			RETURN
			    _Year & "-W" & _WeekPadded
			
			```
		lineageTag: 8e4886ce-c655-4259-86c9-af1f8477c2d9

