	measure 'Accumulated Days without LTI' =
			
			var LatestIssueDate =
			CALCULATE(
			    MAX('Digital_Huddle KPI_data'[Date]),
			    FILTER('Digital_Huddle KPI_data','Digital_Huddle KPI_data'[Actual_value]>=3)
			    )
			var AdjustedStartDate =
			IF(
			    ISBLANK(LatestIssueDate),
			    MIN('Digital_Huddle KPI_data'[Date]),
			    LatestIssueDate)
			var CountDays =
			DATEDIFF(AdjustedStartDate,MAX('Digital_Huddle KPI_data'[Date]),DAY)+1
			RETURN
			CountDays
		formatString: 0
		lineageTag: beaf3525-7549-454d-a488-4f79ef521e91

