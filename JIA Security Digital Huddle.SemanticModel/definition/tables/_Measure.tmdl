	measure CurrentWeek =
			
			VAR _Week = WEEKNUM( TODAY(), 2 )              // 以周一为每周第一天
			VAR _WeekPadded =
			    IF( _Week < 10,
			        "0" & _Week,
			        _Week
			    )
			RETURN
			    "WK" & _WeekPadded
		lineageTag: 90eedba0-9c37-419d-b31a-de7872ae24d0

	measure ShowFilterFlag = ```
			
			VAR TodayDate  = TODAY()
			VAR WeekDayNum = WEEKDAY(TodayDate,2)   -- 2：周一=1，周日=7
			VAR CurDate    = MAX('dDate'[Date])
			VAR PrevWorkday =TodayDate - 1                        -- 其他工作日 → 上一个工作日
			var res = 
			IF(
			    -- 周一：显示上周五、周六、周日
			    WeekDayNum = 1 && CurDate IN { TodayDate - 3, TodayDate - 2, TodayDate - 1 },
			    1,
			    -- 周二~周五：显示上一个工作日
			    IF(WeekDayNum > 1 && WeekDayNum <= 5 && CurDate = PrevWorkday, 1, 0)
			)
			RETURN INT(res)
			```
		lineageTag: 1de3ce2f-c728-43ff-854b-25e5b6b278d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

