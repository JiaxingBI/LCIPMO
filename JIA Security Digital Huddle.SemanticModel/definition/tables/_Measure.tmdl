	measure GLS_light = ```
			
			var HasToday=
			    CALCULATE(
			        COUNTROWS('2025 GLS PLAN'),
			        '2025 GLS PLAN'[Date]=TODAY()
			    )
			
			VAR Istoday= IF(
			    HasToday>0,
			    1,
			    0
			)
			VAR Light=SWITCH(
			    Istoday,
