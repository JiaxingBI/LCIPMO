	measure PDCA_update = ```
			
			var thisweekMonday= TODAY()
			                   - WEEKDAY(TODAY(), 2)  
			                   + 1
			VAR ThisWeekSunday= ThisWeekMonday + 6
			VAR RowsThisWeek =
			    CALCULATE(
			        COUNTROWS('Digital_Huddle PDCA'),
			        'Digital_Huddle PDCA'[Date_of_record] >= ThisWeekMonday,
			        'Digital_Huddle PDCA'[Date_of_record] <= ThisWeekSunday
			    )
			VAR Light=IF(
			    RowsThisWeek>0,
			    UNICHAR(128308),   // 
			    ""    // 🟢  
			)
			RETURN Light
			```
		lineageTag: 155fcad7-9561-4a19-bc8a-a5723b5affcd

	measure IncifindESPA = ```
			var LastDataDate =
			CALCULATE(
			    MAX('Incident Finding'[Date]),
			    FILTER(
			        'Incident Finding',
			        'Incident Finding'[FindingCategory]="Incident Finding (ESPA)"
			    )
			)
			VAR Istoday= IF(
			    (LastDataDate = TODAY())||(LastDataDate = TODAY()-1),
			    1,
			    0
			)
			VAR Light=SWITCH(
			    Istoday,
			    1, UNICHAR(128308),   // 
			    0,"🟢"    // 🟢  
			)
			RETURN Light
			    
			```
		displayFolder: Title
		lineageTag: 6a06a6b9-019e-49f2-a344-45c1aeb6fc7a

