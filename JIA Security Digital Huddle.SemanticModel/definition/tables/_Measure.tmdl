			 var thisWeekEnd = CALCULATE(MAX(dDate[Date]),dDate[IsCurrentWeek]="Current Week")
			 var GLSThisWEeek = COUNTROWS(FILTER('2025 GLS PLAN','2025 GLS PLAN'[Date]>=thisWeekStart&&'2025 GLS PLAN'[Date]<=thisWeekEnd && '2025 GLS PLAN'[Status]<>"Closed"))
			 RETURN
