table 'Visitors Today'
	lineageTag: 63af9e0a-ea9f-461e-8daa-87c8c6dd19cb

	measure Period =
			
			VAR curDate = TODAY()
			VAR startD = MAX('Visitors Today'[StartDate_])
			VAR finalD = MAX('Visitors Today'[FinalDate_])
			RETURN
			IF(curDate >= startD && curDate <= finalD, 1, 0)
		formatString: 0
		lineageTag: 21dead70-f982-4eeb-8eae-11868a953942

