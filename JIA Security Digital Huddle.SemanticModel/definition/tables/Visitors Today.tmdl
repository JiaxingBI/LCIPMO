	partition 'Visitors Today' = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(Web.Contents("https://legogroup.sharepoint.com/sites/CHJiaxingSecurity/Shared%20Documents/00%20Digital%20Huddle/Security%20Huddle%20Update.xlsx"), null, true),
				    #"Visitor(s) Today_Sheet" = Source{[Item="Visitor(s) Today",Kind="Sheet"]}[Data],
				    #"Removed Top Rows" = Table.Skip(#"Visitor(s) Today_Sheet",1),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Removed Top Rows", [PromoteAllScalars=true]),
				    #"Removed Blank Rows" = Table.SelectRows(#"Promoted Headers", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null}))),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Removed Blank Rows", "Date", "Date - Copy"),
				    #"Trimmed Text" = Table.TransformColumns(Table.TransformColumnTypes(#"Duplicated Column", {{"Date - Copy", type text}}, "zh-CN"), {{"Date - Copy", Text.Trim, type text}}),
				    #"Split Column by Delimiter" = Table.SplitColumn(#"Trimmed Text", "Date - Copy", Splitter.SplitTextByEachDelimiter({"-"}, QuoteStyle.Csv, false), {"Date - Copy.1", "Date - Copy.2"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Split Column by Delimiter",{{"Date - Copy.1", "Start Date"},{"Date - Copy.2", "Final Date"}}),
				
				    #"Has 4 Digit Year" = Table.AddColumn(#"Renamed Columns", "HasYear", each Text.Length(Text.Select([Start Date], {"0".."9"})) >= 4),
				    #"Added Custom" = Table.AddColumn(#"Has 4 Digit Year", "HasYear2", each Text.Length(Text.Select([Final Date], {"0".."9"})) >= 4),
				
				    #"SlashToSpace" = Table.AddColumn(#"Added Custom", "Norm2", each Text.Replace([Start Date], "/", " ")),
				    #"Added Custom1" = Table.AddColumn(SlashToSpace, "Norm", each Text.Replace([Final Date], "/", " ")),
				
				    CurrentYearText = Text.From(Date.Year(DateTime.LocalNow())),
				    #"Add Year If Missing" = Table.AddColumn(#"Added Custom1", "NormWithYear",
				        each if [HasYear] then Text.Trim([Norm2]) else Text.Trim([Norm2] & " " & CurrentYearText), type text),
				    #"Added Custom2" = Table.AddColumn(#"Add Year If Missing", "NormwithYear.1", each if [HasYear] then Text.Trim([Norm]) else Text.Trim([Norm] & " " & CurrentYearText)),
				    #"Try Parse NormWithYear" = Table.AddColumn(#"Added Custom2", "Parsed",
				        each try Date.FromText([NormWithYear], "en-US") otherwise null, type nullable date),
				    #"Added Custom3" = Table.AddColumn(#"Try Parse NormWithYear", "Parse2", each try Date.FromText([NormwithYear.1], "en-US") otherwise null),
				
				    #"Fallback Parse Original" = Table.AddColumn(#"Added Custom3", "ParsedFallback",
				        each if [Parsed] = null then (try Date.FromText([Date]) otherwise null) else [Parsed], type nullable date),
				    #"Added Custom4" = Table.AddColumn(#"Fallback Parse Original", "ParseFallBack2", each if [Parsed] = null then (try Date.FromText([Date]) otherwise null) else [Parsed]),
				
				    #"Final Date Column" = Table.AddColumn(#"Added Custom4", "StartDate_", each if [Parsed] <> null then [Parsed] else [ParsedFallback]),
				    #"Added Conditional Column" = Table.AddColumn(#"Final Date Column", "FinalDate_", each if [Parse2] <> null then [Parse2] else [ParseFallBack2]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Conditional Column",{{"FinalDate_", type date}, {"StartDate_", type date}}),
				    colsToKeep = List.Distinct(List.Combine({Table.ColumnNames(#"Removed Blank Rows"), {"FinalDate_","StartDate_"}})),
				    #"Keep Original + Final" = Table.SelectColumns(#"Changed Type", List.Intersect({Table.ColumnNames(#"Changed Type"), colsToKeep})),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Keep Original + Final",{{"N", Int64.Type}}),
				    #"Trimmed Text1" = Table.TransformColumns(#"Changed Type1",{{"LEGO HOST", Text.Trim, type text}, {" Contact Person#(lf)Eleanor Xiang :13252319198", Text.Trim, type text}, {"LEGO Department", Text.Trim, type text}})
				in
