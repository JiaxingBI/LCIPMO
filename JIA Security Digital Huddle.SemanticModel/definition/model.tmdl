model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-150
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Digital_Huddle KPI_data","Digital_Huddle Departments","Digital_Huddle GLS","Digital_Huddle KPIs","Digital_Huddle PDCA","Security_Q","Security_D","Incident Finding","Abnormal Finding","Alarm Response","Complaint & Appreciation","Access Issue","Penetration Test","S&M Malfunction","Project Tracker","2025 GLS PLAN","Crisis Excercise","Purchase Application","Attendance & Absence","LEGO Security Training","Visitors Today","Top Focus","Complaint To Aden (Q7)","SCL Availability","Others","CCTV Availability","Night Inspection","On-duty Plan","Archive","Night Inspection_detail","dDate","ParkingRate","Coordinator Skill Matrix","Monitor Skill Matrix","dPene","dAlarmArea"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop","WebModelingEdit"]

annotation __TEdtr = 1

ref table _Measure
ref table 'Digital_Huddle KPI_data'
ref table 'Digital_Huddle Departments'
ref table 'Digital_Huddle GLS'
ref table 'Digital_Huddle KPIs'
ref table 'Digital_Huddle PDCA'
ref table Security_Q
ref table Security_D
ref table 'Incident Finding'
ref table 'Abnormal Finding'
ref table 'Alarm Response'
ref table 'Complaint & Appreciation'
ref table 'Access Issue'
ref table 'Penetration Test'
ref table 'S&M Malfunction'
ref table 'Project Tracker'
ref table '2025 GLS PLAN'
ref table 'Crisis Excercise'
ref table 'Purchase Application'
ref table 'Attendance & Absence'
ref table 'LEGO Security Training'
ref table 'Visitors Today'
ref table 'Top Focus'
ref table 'Complaint To Aden (Q7)'
ref table 'SCL Availability'
ref table 'CCTV Availability'
ref table Others
ref table 'Night Inspection'
ref table 'On-duty Plan'
ref table Archive
ref table 'Night Inspection_detail'
ref table dDate
ref table ParkingRate
ref table 'Coordinator Skill Matrix'
ref table 'Monitor Skill Matrix'
ref table dPene
ref table dAlarmArea

ref cultureInfo en-US

