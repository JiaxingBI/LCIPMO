	measure DisplayValue = ```
			
			VAR v = [IncidentFindingESPA1]
			RETURN
			  -- 如果 v = 0 或者大于 0，都把它格式化成字符串
			  IF(
			    NOT( ISBLANK(v) ),
			    BLANK(),   -- “0” 保留整数，无小数
			    0             -- 如果你真的要隐藏完全不存在的分类，可返回 BLANK()
			  )
			
			```
