	measure 'Accumulated Days without LTI' = ```
			
			var LatestIssueDate = 
			CALCULATE(
			    MAX('Digital_Huddle KPI_data'[Date]),
			    FILTER('Digital_Huddle KPI_data','Digital_Huddle KPI_data'[Actual_value]>0)
			    )
			var AdjustedStartDate = 
			    IF(
			        ISBLANK(LatestIssueDate),
			        MIN('Digital_Huddle KPI_data'[Date]),
			        LatestIssueDate)
			var CountDays =
			    DATEDIFF(AdjustedStartDate,TODAY(),DAY)
			RETURN
			CountDays
			```
		formatString: 0
		lineageTag: beaf3525-7549-454d-a488-4f79ef521e91

	measure TopFocus_HTML =
			
			VAR Style =
			    "<style>
			    .carousel-container {
			        width:510px; height:470px;
			        position:relative; overflow:hidden; border-radius:10px;
			    }
			    .carousel-wrapper {
			        display:flex; flex-direction:column;
			        animation:slide-vertical-smooth 12s infinite ease-in-out;
			    }
			    .carousel-container:hover .carousel-wrapper {
			        animation-play-state:paused;
			    }
			    @keyframes slide-vertical-smooth {
			        0%      { transform:translateY(0);       opacity:1; }
			        16.67%  { transform:translateY(0);       opacity:1; }
			        25%     { transform:translateY(-470px);  opacity:0.8; }
			        33.33%  { transform:translateY(-470px);  opacity:1; }
			        50%     { transform:translateY(-470px);  opacity:1; }
			        58.33%  { transform:translateY(-940px); opacity:0.8; }
			        66.67%  { transform:translateY(-940px); opacity:1; }
			        83.33%  { transform:translateY(-940px); opacity:1; }
			        91.67%  { transform:translateY(0);       opacity:0.8; }
			        100%    { transform:translateY(0);       opacity:1; }
			    }
			    </style>"
			
			VAR CardQuarterly =
			    "<div style='width:500px;height:470px;margin:0;
			                 background-color:#005f73;color:#ffffff;
			                 border-radius:10px;box-shadow:0 6px 15px rgba(0,0,0,0.15);
			                 display:flex;flex-direction:column;
			                 justify-content:flex-start;align-items:flex-start;
			                 padding:20px 20px 20px 30px;box-sizing:border-box;text-align:left;'>
			        <div style='width:100%;font-size:36px;font-weight:bold;margin-bottom:8px;text-align:center;'>Quarterly</div>
			        <div style='font-size:24px;line-height:1.2;width:100%;'>" &
			            CONCATENATEX(
			                FILTER( ALL( 'Top Focus' ), 'Top Focus'[FocusType] = "Quarterly" ),
			                "<div style='margin-bottom:5px;'>
			                    <div style='font-weight:bold;'>" & [Title] & "</div>
			                    <div>" & [Detail] & "</div>
			                </div>",
			                ""
			            )
			        & "</div>
			    </div>"
			
			VAR CardMonthly =
			    "<div style='width:500px;height:470px;margin:0;
			                 background-color:#ee7624;color:#ffffff;
			                 border-radius:10px;box-shadow:0 6px 15px rgba(0,0,0,0.15);
			                 display:flex;flex-direction:column;
			                 justify-content:flex-start;align-items:flex-start;
			                 padding:20px 20px 20px 30px;box-sizing:border-box;text-align:left;'>
			        <div style='width:100%;font-size:36px;font-weight:bold;margin-bottom:8px;text-align:center;'>Monthly</div>
			        <div style='font-size:18px;line-height:1.2;width:100%;'>" &
			            CONCATENATEX(
			                FILTER( ALL( 'Top Focus' ), 'Top Focus'[FocusType] = "Monthly" ),
			                "<div style='margin-bottom:5px;'>
			                    <div style='font-weight:bold;'>" & [Title] & "</div>
			                    <div>" & [Detail] & "</div>
			                </div>",
			                ""
			            )
			        & "</div>
			    </div>"
			
			VAR CardWeekly =
			    "<div style='width:500px;height:490px;margin:0;
			                 background-color:#9b2bc7;color:#ffffff;
			                 border-radius:10px;box-shadow:0 6px 15px rgba(0,0,0,0.15);
			                 display:flex;flex-direction:column;
			                 justify-content:flex-start;align-items:flex-start;
			                 padding:20px 20px 20px 30px;box-sizing:border-box;text-align:left;'>
			        <div style='width:100%;font-size:36px;font-weight:bold;margin-bottom:8px;text-align:center;'>Weekly</div>
			        <div style='font-size:24px;line-height:1.2;width:100%;'>" &
			            CONCATENATEX(
			                FILTER( ALL( 'Top Focus' ), 'Top Focus'[FocusType] = "Weekly" ),
			                "<div style='margin-bottom:5px;'>
			                    <div style='font-weight:bold;'>" & [Title] & "</div>
			                    <div>" & [Detail] & "</div>
			                </div>",
			                ""
			            )
			        & "</div>
			    </div>"
			
			VAR HtmlWrapper =
			    "<div class='carousel-container'>" &
			        "<div class='carousel-wrapper'>" &
			            CardQuarterly &
			            CardMonthly &
			            CardWeekly &
			        "</div>" &
			    "</div>"
			
			RETURN
			Style & HtmlWrapper
		lineageTag: 51f7bf8f-0249-421e-9de2-ac1003a3b328

	column Column
		formatString: 0
		lineageTag: ad3f307a-c628-464c-af44-6a61cc60496b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Measure = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = cdd8a6e620a94e16b4ea7a44245de7f4

